# Ignored file patterns.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Visual Studio Code
.vscode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# NativeScript files
hooks/
node_modules/
platforms/
dist/
*.js
*.js.map
!webpack.config.js

# Maven
target/
dist/

# Log files
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Common
.LSOverride
.cloud
.project
tmp/
typings/

# Generated by MacOS
.DS_Store
.AppleDouble

# Generated by Windows
Thumbs.db

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

